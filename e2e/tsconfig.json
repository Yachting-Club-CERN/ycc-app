{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "types": ["node"],
    "incremental": false,
    // Avoid polluting test files with unnecessary ! assertions
    "noUncheckedIndexedAccess": false,
    "paths": {
      "@e2e/*": ["./e2e/*"]
    }
  },
  "include": ["**/*.ts"]
}
