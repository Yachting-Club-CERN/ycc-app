{
  "name": "ycc-app",
  "version": "1.4.1",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "tsc && vite build",
    "check": "pnpm format:check && pnpm lint && pnpm check-types",
    "check:fix": "pnpm format && pnpm lint --fix && pnpm check-types",
    "check-types": "tsc --noEmit && tsc --noEmit -p tests/tsconfig.json && tsc --noEmit -p e2e/tsconfig.json",
    "clean": "pnpx rimraf@6.1.2 .eslintcache .playwright-cli coverage dist playwright-report node_modules test-results && pnpx rimraf@6.1.2 --glob  \"**/*.tsbuildinfo\"",
    "dev": "vite",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "coverage": "vitest --coverage",
    "format": "prettier --write '**/*.{js,ts,jsx,tsx,cjs,cts,mjs,mts,json,jsonc,json5,css,md}'",
    "format:check": "prettier --check './**/*.{js,ts,jsx,tsx,cjs,cts,mjs,mts,json,jsonc,json5,css,md}'",
    "lint": "eslint . --cache",
    "start": "vite preview",
    "test": "vitest",
    "test:ci": "vitest --run"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource/roboto": "^5.2.10",
    "@fontsource/roboto-mono": "^5.2.8",
    "@mui/icons-material": "^7.3.9",
    "@mui/material": "^7.3.9",
    "@mui/x-data-grid": "^8.28.0",
    "@mui/x-date-pickers": "^8.27.2",
    "@tiptap/core": "^2.27.2",
    "@tiptap/extension-heading": "^2.27.2",
    "@tiptap/extension-highlight": "^2.27.2",
    "@tiptap/extension-image": "^2.27.2",
    "@tiptap/extension-link": "^2.27.2",
    "@tiptap/extension-placeholder": "^2.27.2",
    "@tiptap/extension-table": "^2.27.2",
    "@tiptap/extension-underline": "^2.27.2",
    "@tiptap/react": "^2.27.2",
    "@tiptap/starter-kit": "^2.27.2",
    "axios": "^1.15.0",
    "dayjs": "^1.11.20",
    "html-react-parser": "^5.2.17",
    "keycloak-js": "^26.2.3",
    "mui-tiptap": "^1.29.1",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-dropzone": "^15.0.0",
    "react-error-boundary": "^6.1.1",
    "react-hook-form": "^7.72.1",
    "react-hook-form-mui": "^8.2.0",
    "react-router-dom": "^7.14.0",
    "swiper": "^12.1.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@emotion/babel-plugin": "^11.13.5",
    "@eslint/css": "^1.1.0",
    "@eslint/js": "^9.39.4",
    "@eslint/json": "^1.2.0",
    "@eslint/markdown": "^7.5.1",
    "@playwright/cli": "^0.1.6",
    "@playwright/test": "^1.59.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^4.1.4",
    "@vitest/ui": "^4.1.4",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.4.0",
    "jiti": "^2.6.1",
    "jsdom": "^29.0.2",
    "prettier": "^3.8.2",
    "rollup-plugin-visualizer": "^7.0.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.58.1",
    "vite": "^7.3.2",
    "vite-plugin-pwa": "^1.2.0",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.4"
  },
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=24"
  }
}