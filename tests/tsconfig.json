{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../tsconfig.json",
  "compilerOptions": {
    // Orval's generated MSW mocks violate exactOptionalPropertyTypes
    "exactOptionalPropertyTypes": false,
    "incremental": false,
    // Avoid polluting test files with unnecessary ! assertions
    "noUncheckedIndexedAccess": false,
    "paths": {
      "@/*": ["./src/*"],
      "@tests/*": ["./tests/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx"]
}
